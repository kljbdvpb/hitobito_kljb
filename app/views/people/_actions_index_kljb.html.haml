-# Vorstand/Leiterrunde: Hinweis-Button, solange Personen ohne Mitgliedsrolle in der Ortsgruppe da sind
- if Kljb::BoardMembership.no_new_person?(@group) && can?(:manage_person_duplicates, @group)
  - missing = Kljb::BoardMembership.without_membership(@group).count
  - if missing.positive?
    = action_button(t('kljb.board_membership.report_button', count: missing), group_board_member_check_path(@group), :'user-times')

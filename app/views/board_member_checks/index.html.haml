- title group.to_s

= content_for(:filter) do
  %div.toolbar-pills.mb-3
    %ul.nav.nav-pills.group-pills.border.border-light.rounded
      %li.nav-item
        = link_to('<<', group_people_path(group), class: 'nav-link rounded-0 py-1 px-3 mr-0')
      %li.nav-item
        = link_to(t('kljb.board_membership.report_title'), group_board_member_check_path(group), class: 'nav-link active rounded-0 py-1 px-3 mr-0')

%p= t('kljb.board_membership.report_intro', layer: Kljb::BoardMembership.membership_scope_label(group))
- if Kljb::BoardMembership.exempt_role_label(group)
  %p= t('kljb.board_membership.report_exempt', role: Kljb::BoardMembership.exempt_role_label(group))
%p= link_to(t('kljb.board_membership.duplicates_link', layer: group.layer_group.to_s), group_person_duplicates_path(group.layer_group))

- if people.empty?
  %p= t('kljb.board_membership.report_empty')
- else
  %table.table.table-striped
    %thead
      %tr
        %th= Person.model_name.human
        %th= Role.model_name.human
    %tbody
      - people.each do |person|
        %tr
          %td
            - if can?(:show, person)
              = link_to(person.to_s, group_person_path(group, person))
            - else
              = person.to_s
          %td= person.roles.select { |r| r.group_id == group.id }.map { |r| r.to_s }.join(', ')
